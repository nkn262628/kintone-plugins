{
  "manifest_version": 1,
  "version": 1,
  "type": "APP",
  "name": {
    "ja": "自動採番プラグイン",
    "en": "Auto Numbering Plugin",
    "zh": "自動編號外掛",
    "zh-TW": "自動編號外掛"
  },
  "description": {
    "ja": "アプリに日付ベースの自動採番機能を提供します",
    "en": "Provides auto-numbering for apps with date-based format",
    "zh": "為應用程式提供含日期的自動編號功能",
    "zh-TW": "為應用程式提供含日期的自動編號功能"
  },
  "icon": "image/icon.png",
  "config": {
    "html": "html/config.html",
    "js": [
      "js/config.js"
    ],
    "css": [
      "css/config.css"
    ],
    "required_params": [
      "fieldCode",
      "prefix"
    ]
  },
  "desktop": {
    "js": [
      "js/desktop.js"
    ],
    "css": [
      "css/desktop.css"
    ]
  },
  "mobile": {
    "js": [
      "js/desktop.js"
    ],
    "css": [
      "css/desktop.css"
    ]
  }
}